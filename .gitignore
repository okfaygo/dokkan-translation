# scrape cache and generated index (rebuild with prototype/build_index.py)
prototype/cache/
prototype/index.json
__pycache__/

# scratch id lists from targeted re-scrapes
prototype/_*.txt

# signing keystores must never reach a public repo
*.jks
*.keystore
keystore.properties

# IDE project files. android/.gitignore already covers android/.idea/, but
# Android Studio also writes one at the repo root when opened from here.
.idea/
*.iml

# scrape run logs
prototype/*.log

# The article's demo clip: 3.3MB of video that belongs in the
# published artifact, not in git history.
article/demo_clip.mp4
